From 23a36b444d19dca379e91ac3e9e727421217c421 Mon Sep 17 00:00:00 2001
From: Drei Guintu <6581480+alguintu@users.noreply.github.com>
Date: Sun, 8 Nov 2026 14:39:57 +0800
Subject: [PATCH] Expose glyph outlines and plans for morphing beyond icons

Add MorphFont (parse font bytes, read a glyph by code point in ems about
its origin), MorphGlyph and MorphGlyphPlan (pair two glyphs' contours and
interpolate them), so packages such as text morphing can build on
morphnext's outline engine without importing lib/src.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 lib/morphnext.dart            |   1 +
 lib/src/morph_glyph.dart      | 133 ++++++++++++++++++++++++++++++++++
 lib/src/morph_repository.dart |   6 +-
 test/morph_glyph_test.dart    |  50 +++++++++++++
 4 files changed, 188 insertions(+), 2 deletions(-)
 create mode 100644 lib/src/morph_glyph.dart
 create mode 100644 test/morph_glyph_test.dart

diff --git a/lib/morphnext.dart b/lib/morphnext.dart
index ffa5d89..64e1bce 100644
--- a/lib/morphnext.dart
+++ b/lib/morphnext.dart
@@ -3,6 +3,7 @@ library;
 
 export 'package:flutter/physics.dart' show SpringDescription;
 export 'src/cache/morph_cache.dart' show MorphCache;
